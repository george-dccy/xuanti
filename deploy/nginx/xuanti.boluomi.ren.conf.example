# 先将本文件复制到 /etc/nginx/sites-available/xuanti.boluomi.ren，
# 按服务器证书路径调整后，再执行 nginx -t && systemctl reload nginx。
# 端口 18000 由 deploy/pm2/ecosystem.config.cjs 固定，应用只监听本机回环地址。

server {
    listen 80;
    listen [::]:80;
    server_name xuanti.boluomi.ren;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name xuanti.boluomi.ren;

    ssl_certificate /etc/letsencrypt/live/xuanti.boluomi.ren/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xuanti.boluomi.ren/privkey.pem;

    # CreatorHub 本身默认没有登录鉴权。
    # 公网开放前，建议取消下面两行的注释，并先创建 htpasswd 文件：
    # auth_basic "CreatorHub";
    # auth_basic_user_file /etc/nginx/.htpasswd-creatorhub;

    client_max_body_size 512m;

    location / {
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
